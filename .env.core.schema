# ============================================================================
# .env.core.schema - GENERATED from cli/lib/variables-manifest.ts. DO NOT EDIT.
# ============================================================================
# SYNCED by the boilerplate updater (component env-schema). Regenerate with
#   bun run vars:schema        and gate it with    bun run vars:schema:check
# Imported by the project-owned .env.schema, which holds the root
# decorators and the project's own variables.
#
# This file declares NAMES, types and sensitivity. It never holds a value:
# fill .env (or .env.local). Validate (redacted): bunx varlock load --agent
#
# Nothing here is required: a fresh clone has no Supabase project or Atlassian
# site yet, and the consumer that reads a variable fails by name when it is
# empty. A project that wants a stronger contract re-declares the item in
# .env.schema as required (the importing file wins).
#
# The import below is the OPTIONAL secret-manager overlay (.env.provider.schema,
# references only, written by `bun setup` when a project opts in). Absent
# = nothing changes: values come from .env / .env.local.
# @import(./.env.provider.schema, allowMissing=true)
# @defaultRequired=false
# @defaultSensitive=false
# ---

# ----------------------------------------------------------------------------
# Routed variables: tool credentials, the Supabase / Postgres backend, app
# config, the automation identity, n8n. Every @sensitive item is a secret the
# agent references by NAME only (Critical Rule #1).
# Source: cli/lib/variables-manifest.ts. Order = manifest order.
# ----------------------------------------------------------------------------

# Atlassian account email (acli + scripts/sync-jira-*.ts). Critical tool credential — prompted at install.
# @type=email @docs(https://id.atlassian.com/manage-profile/security/api-tokens)
ATLASSIAN_EMAIL=

# Atlassian API token (acli + scripts/sync-jira-*.ts). Critical tool credential — prompted at install.
# @sensitive @docs(https://id.atlassian.com/manage-profile/security/api-tokens)
ATLASSIAN_API_TOKEN=

# Resend API key (transactional email + resend CLI auth). Critical tool credential — prompted at install; app runtime → also reaches Vercel.
# @sensitive @docs(https://resend.com/api-keys)
RESEND_API_KEY=

# Supabase project URL (browser-safe). App runtime. Vercel+Supabase integration generates only this var.
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
# @type=url @example="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_URL=

# Supabase new-style publishable key (browser-safe, replaces anon key).
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
SUPABASE_PUBLISHABLE_KEY=

# Browser-side copy of the publishable key, read by the Supabase browser client (Next.js only inlines NEXT_PUBLIC_* into client bundles). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY still works while Supabase keeps the legacy pair.
# Obtain: Same value as SUPABASE_PUBLISHABLE_KEY (Supabase dashboard → Project Settings → API). The Supabase↔Vercel integration does not provision this name: set it in .env and in Vercel by hand.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase new-style secret key (server only, replaces service_role).
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
# @sensitive
SUPABASE_SECRET_KEY=

# Secret used to sign / verify custom JWTs. Known to doctor but not the installer today.
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
# @sensitive
SUPABASE_JWT_SECRET=

# Direct Postgres host for the Supabase project (db.<project-ref>.supabase.co).
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
POSTGRES_HOST=

# Postgres user (default: postgres).
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
# @example="postgres"
POSTGRES_USER=

# Postgres password for the project.
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
# @sensitive
POSTGRES_PASSWORD=

# Postgres database name (default: postgres).
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
# @example="postgres"
POSTGRES_DATABASE=

# Pooled Postgres connection string (port 6543). Contains the password → secret.
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
# @sensitive
POSTGRES_URL=

# Direct Postgres connection string (port 5432). Contains the password → secret.
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
# @sensitive
POSTGRES_URL_NON_POOLING=

# Pooled connection with pgbouncer=true (for Prisma ORM). Contains the password → secret.
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`.
# @sensitive
POSTGRES_PRISMA_URL=

# Base URL for auth redirects, OAuth callbacks, email links. Referenced in code; previously untracked by installer AND doctor.
# Obtain: Auto-provisioned by Supabase↔Vercel — pull with `vercel env pull` via `bun setup --variables`. Defaults to http://localhost:3000 locally.
# @type=url @example="http://localhost:3000"
NEXT_PUBLIC_APP_URL=

# Email of the automation identity used by live-UI validation / authenticated HTTP probes. Local only.
# Obtain: Provision a DEDICATED non-production account (no real data, minimum privileges), then declare its var name in `.agents/project.yaml` → testing.automation_identity.email_var. Never a real user, admin, or production account.
# @type=email @example="qa.automation@example.test"
QA_E2E_USER_EMAIL=

# Password of the automation identity. Local only, secret.
# Obtain: Password of the dedicated automation account above. Read at runtime from .env by the automation script; never inlined in code, plans, or PR bodies.
# @sensitive
QA_E2E_USER_PASSWORD=

# n8n instance API URL for the n8n MCP server (project-bound). Local only.
# Obtain: Your n8n instance → Settings → API (e.g. https://n8n.yourapp.com/api/v1). Only needed if you use the n8n MCP server.
# @type=url @example="https://n8n.example.test/api/v1"
N8N_API_URL=

# n8n API key for the n8n MCP server. Local only.
# Obtain: Your n8n instance → Settings → API. Only needed if you use the n8n MCP server.
# @sensitive
N8N_API_KEY=

# ----------------------------------------------------------------------------
# Unrouted variables. Never pushed by the installer; declared so a .env copied
# from the template, or pulled from Vercel, validates.
# ----------------------------------------------------------------------------

# Supabase personal access token for the Supabase MCP server (.mcp.json, opencode.jsonc, .codex/config.toml). Dashboard, Account, Access Tokens.
# @sensitive
SUPABASE_ACCESS_TOKEN=

# Default project key for bun run jira:sync-issues; falls back to .agents/project.yaml.
JIRA_PROJECT_KEY=

# Output directory for synced issues (default .context/PBI).
JIRA_SYNC_OUTPUT=

# Legacy browser-safe anon key. Valid while Supabase keeps the legacy pair; the publishable key replaces it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy anon key (server-side copy). Valid while Supabase keeps the legacy pair.
SUPABASE_ANON_KEY=

# Legacy service_role key (server only). Valid while Supabase keeps the legacy pair; the secret key replaces it.
# @sensitive
SUPABASE_SERVICE_ROLE_KEY=
