# ============================================================================
#* AI-DRIVEN SOFTWARE PROJECT - ENVIRONMENT VARIABLES
# ============================================================================
#
# Quick Start:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your values (see comments below)
# 3. Never commit .env to git (it's in .gitignore)
#
# Documentation: docs/mcp-builder-strategy.md
# ============================================================================

# ----------------------------------------------------------------------------
#* AI AGENT MCP SERVERS — loading mechanics
# ----------------------------------------------------------------------------
# .mcp.json (Claude Code) and opencode.jsonc are committed to git and reference
# env vars via expansion:
#   - .mcp.json      → ${VAR_NAME} / ${VAR:-default}  (FAILS if missing)
#   - opencode.jsonc → {env:VAR_NAME}                 (empty string if missing)
#
# Two ways to load these vars before launching the agent:
#
#   A) Cross-platform wrapper (default, works on Windows/Mac/Linux):
#        bun run claude     → wraps `claude` with dotenv-cli
#        bun run opencode   → idem
#
#   B) Optional, Mac/Linux only: direnv auto-loads on `cd` into the repo.
#      See .envrc for the one-time setup. Once configured, run
#      `claude` / `opencode` directly — direnv exports .env into your shell.
# ----------------------------------------------------------------------------


# ============================================================================
#* ATLASSIAN — credentials (the HOST is deliberately NOT here)
# ============================================================================
# These two cover every Atlassian consumer in this repo:
#   - acli CLI (skill .claude/skills/acli)
#   - scripts/sync-jira-*.ts (raw REST calls)
#   - cli/install.ts auth loop
#   - (opt-in) MCP atlassian server — see docs/mcp/ to enable it manually
#
# THE SITE URL IS NOT A VARIABLE HERE. It lives in
#   .agents/project.yaml  ->  issue_tracker.atlassian_url
# and nowhere else locally. Reason: a stale ATLASSIAN_URL inherited from the
# PROCESS environment silently shadows this file (both bun's autoload and
# dotenv-cli skip a var that is already set, and a restart re-inherits it), and
# `jira:sync-issues` then rebuilt .context/PBI/ from a DEAD Jira site with exit
# code 0 and no warning. The host is project identity, so it is anchored to a
# versioned file that shows up in a diff.
#
#   Read it:   bun run --silent jira:url          -> https://acme.atlassian.net
#              bun run --silent jira:url --slug   -> acme.atlassian.net
#   Set it:    bun run agents:setup               (or the installer prompt)
#
# The NAME still exists as runtime config in the Vercel env scopes, for the
# serverless Jira integration — pushed there from the yaml by
# `bun run setup --variables`, so the two can never drift.
#
# Naming rule:
#   - ATLASSIAN_*  = credentials
#   - JIRA_*       = operational (project key, output dir, custom field, etc.)
#
# Get an API token: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# --- Jira operational params (NOT credentials) ---
# Default project key for `bun run jira:sync-issues` (else .agents/project.yaml).
# JIRA_PROJECT_KEY=
# Output directory for synced issues (default: .context/PBI).
# JIRA_SYNC_OUTPUT=


# ============================================================================
#* SEARCH / DOCS MCPs
# ============================================================================
# Tavily — web search MCP — https://app.tavily.com/
TAVILY_API_KEY=


# ============================================================================
#* AUTOMATION MCPs
# ============================================================================
# n8n MCP — workflow automation instance
N8N_API_URL=
N8N_API_KEY=


# ============================================================================
#* RESEND — Transactional email
# ============================================================================
# Get a key: https://resend.com/api-keys
# Docs: https://resend.com/docs/api-reference/introduction
# Used by application code AND for `resend` CLI authentication
# (CLI also supports browser auth: `resend login`).
RESEND_API_KEY=
# Sender for the BK-214 notification digest. Defaults to Resend's sandbox
# address (no domain verification needed) — swap to a verified domain when
# one exists, e.g. `Bunkai <digest@bunkai.example>`.
RESEND_DIGEST_FROM_EMAIL=Bunkai <onboarding@resend.dev>


# ============================================================================
#* CRON — Scheduled job authentication
# ============================================================================
# Bearer secret Vercel Cron sends on scheduled requests (see `vercel.json`).
# Generate one with: openssl rand -hex 32
# The same value must be set in Vercel's Preview and Production env scopes.
CRON_SECRET=


# ============================================================================
#* STRIPE — Billing (BK-230)
# ============================================================================
# Get keys: https://dashboard.stripe.com/apikeys (test mode for local/staging)
# Webhook signing secret: https://dashboard.stripe.com/webhooks (or `stripe
# listen --print-secret` for local testing with the Stripe CLI)
# Cloud tier price id: https://dashboard.stripe.com/products (a recurring,
# per-seat "Cloud" price — Checkout uses its quantity as the seat count)
# Optional: a workspace can never reach Stripe without these configured — the
# checkout route answers `payment_processor_unavailable` (503) instead of a
# boot-time crash when they are unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLOUD_PRICE_ID=


# ============================================================================
#* SUPABASE — MCP control plane
# ============================================================================
# Personal Access Token for Supabase MCP (project management, migrations,
# advisors, edge functions). Admin-scope.
# Get token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=


# ============================================================================
#* SUPABASE — Project Backend (Required)
# ============================================================================
# Find these values in Supabase Dashboard → Settings → API
# Using NEW-STYLE keys (publishable + secret). Legacy anon/service_role keys
# are intentionally NOT listed here — modern Supabase projects use the new pair.
# The Vercel+Supabase integration generates ONLY NEXT_PUBLIC_SUPABASE_URL (no
# server-side SUPABASE_URL counterpart) — server code should read the
# NEXT_PUBLIC_* var directly, and `.mcp.json` / `opencode.jsonc` already
# bridge it into the Supabase MCP server's expected SUPABASE_URL env name.
NEXT_PUBLIC_SUPABASE_URL=           # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=           # publishable key (browser-safe)
SUPABASE_SECRET_KEY=                # secret key (server only)
SUPABASE_JWT_SECRET=                # sign / verify custom JWTs

#! TIP: Copy all Supabase vars at once from Vercel:
# 1. Open Vercel Project Storage: https://vercel.com/{org}/{project}/stores
# 2. Select your Supabase store (database)
# 3. Quickstart → "Copy Snippet"
# 4. Paste into your .env


# ============================================================================
#* POSTGRES — direct connection (Required if using Prisma / raw SQL)
# ============================================================================
POSTGRES_HOST=                      # db.<project-ref>.supabase.co
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=postgres
POSTGRES_URL=                       # pooled (port 6543, supa=base-pooler.x)
POSTGRES_URL_NON_POOLING=           # direct (port 5432)
POSTGRES_PRISMA_URL=                # pooled + pgbouncer=true (Prisma)


# ============================================================================
#* APP CONFIG (Required)
# ============================================================================
# Base URL for auth redirects, OAuth callbacks, email links.
# Local dev: http://localhost:3000 | Production: your deployed URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ============================================================================
#* AUTOMATION IDENTITY — the account automation logs in as (Optional)
# ============================================================================
# Used by live-UI validation and authenticated HTTP probes during
# /sprint-development. Provision a DEDICATED non-production account: no real
# customer data, minimum privileges, owned by no real person.
#
# These are the RECOMMENDED DEFAULT names. Your project may rename them — if it
# does, rename them in `cli/lib/variables-manifest.ts` too, and declare the new
# names in `.agents/project.yaml` → `testing.automation_identity`.
#
# HARD RULE: automation authenticates through the app's OWN login path. Never
# through a service-role / admin key, an admin user-management API, a generated
# magic link, a hand-crafted token, or any account other than this one. If this
# identity is missing, the sprint STOPS — it never improvises a login.
# Full contract: .claude/skills/sprint-development/references/live-ui-identity.md
QA_E2E_USER_EMAIL=
QA_E2E_USER_PASSWORD=


# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# - Variables starting with NEXT_PUBLIC_ are exposed to the browser (Next.js)
# - Never commit real values to git
# - Keep this .env.example file updated when adding new variables
# - Use descriptive comments to help your team understand each variable
# ----------------------------------------------------------------------------
