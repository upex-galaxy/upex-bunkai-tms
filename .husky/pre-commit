bunx lint-staged

# Light-weight repo health checks on every commit (fast, cover full repo).
bun run types:check
bun run vars:check
bun run skills:check

# skill-registry freshness gate — only runs when staged files affect it.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if echo "$STAGED" | grep -qE '^(\.claude/skills/.+/SKILL\.md$|scripts/build-skill-registry\.ts$|\.claude/skills/REGISTRY\.md$)'; then
  bun run skills:registry:check || {
    echo ""
    echo "❌ .claude/skills/REGISTRY.md is stale. Fix:"
    echo "   bun run skills:registry && git add .claude/skills/REGISTRY.md"
    exit 1
  }
fi

# openapi spec freshness gate — only runs when staged files affect the spec.
if echo "$STAGED" | grep -qE '^(app/api/.+/route\.openapi\.ts$|scripts/openapi-gen\.ts$|lib/openapi/.+$|public/openapi\.json$)'; then
  bun run openapi:check || {
    echo ""
    echo "❌ public/openapi.json is stale. Fix:"
    echo "   bun run openapi:gen && git add public/openapi.json"
    exit 1
  }
fi
