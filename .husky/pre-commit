# lint-staged lints and formats the staged files with the project's own
# config. An adopted app may have none (its formatting is its own, and the
# adoption never adds one): then it is skipped, never a failed commit.
if grep -Eq '"lint-staged"[[:space:]]*:[[:space:]]*\{' package.json 2>/dev/null \
  || [ -n "$(ls -d .lintstagedrc* lint-staged.config.* 2>/dev/null)" ]; then
  bunx lint-staged
fi

# Framework gates, in one call. They live in `.husky/framework-gates.sh`, which
# the boilerplate updater SYNCS, while this hook is project-owned and never
# overwritten, so a gate added upstream lands here without rewriting your file.
# The `-f` guard is required: `.husky/_/h` runs this under `sh -e`, and sourcing
# a file that is not there would kill the hook.
#
# Your own gates go around this call; the ordering in this file is yours.
# `lint-staged` stays above it on purpose: it REWRITES staged files, so it has
# to finish before anything reads the staged list.
GATES="$(dirname -- "$0")/framework-gates.sh"
if [ -f "$GATES" ]; then
  . "$GATES"
  framework_gates_pre_commit
else
  echo "⚠️  .husky/framework-gates.sh missing: framework pre-commit gates SKIPPED."
  echo "   Restore it with: bun sync"
fi

# openapi spec freshness gate — only runs when staged files affect the spec.
# Bunkai-specific (kept across boilerplate syncs): public/openapi.json is
# generated from the route.openapi.ts modules and must never drift.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if echo "$STAGED" | grep -qE '^(app/api/.+/route\.openapi\.ts$|scripts/openapi-gen\.ts$|lib/openapi/.+$|public/openapi\.json$)'; then
  bun run openapi:check || {
    echo ""
    echo "❌ public/openapi.json is stale. Fix:"
    echo "   bun run openapi:gen && git add public/openapi.json"
    exit 1
  }
fi
