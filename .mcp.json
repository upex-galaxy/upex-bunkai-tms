{
  "mcpServers": {
    "context7": {
      "command": "bunx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "tavily": {
      "command": "bunx",
      "args": [
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "TAVILY_API_KEY",
        "--",
        "bunx",
        "-y",
        "tavily-mcp@latest"
      ]
    },
    "supabase": {
      "command": "bunx",
      "args": [
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "SUPABASE_ACCESS_TOKEN",
        "--",
        "bunx",
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ]
    },
    "n8n": {
      "command": "bunx",
      "args": [
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "N8N_API_URL,N8N_API_KEY",
        "--",
        "npx",
        "-y",
        "n8n-mcp"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true"
      }
    },
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp@latest", "--extension"]
    },
    "dbhub": {
      "command": "bunx",
      "args": [
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "DBHUB_TYPE,DBHUB_HOST,DBHUB_PORT,DBHUB_DATABASE,DBHUB_USER,DBHUB_PASSWORD",
        "--",
        "bunx",
        "-y",
        "@bytebase/dbhub@1.2.3",
        "--config",
        "dbhub.toml"
      ]
    }
  }
}
