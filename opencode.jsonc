{
  // OpenCode shared team config, committed to git.
  // Secrets are NEVER stored here, and no plaintext copy of one is written for
  // OpenCode to read. Every server that needs .env values starts through the
  // .env loader:
  //
  //   bunx -p varlock@1.20.0 varlock run --no-redact-stdout --inject vars --filter A,B -- <server>
  //
  // which reads the varlock schema plus .env / .env.local (or the secret manager
  // the schema names) from the project root at spawn time and hands the server
  // ONLY the variables in its --filter. That works however OpenCode was started:
  // a desktop or natively launched session has no process environment, and
  // `{env:VAR}` would resolve to nothing there. `--no-redact-stdout` keeps the
  // JSON-RPC stream byte-intact. The loader is the same on the three hosts
  // (MCP_ENV_LOADER_* in cli/lib/agent-compatibility-contracts.ts, ADR-0012);
  // never add `{env:}` or `{file:}` beside it: an empty value shadows .env.
  // See .env.example for the variables themselves.
  //
  // OpenCode's background service caches the resolved config per directory, so
  // a config change is not seen until it restarts (`opencode service restart`,
  // or quit every OpenCode session).
  //
  // Syntax notes (OpenCode-specific, different from Claude Code's .mcp.json):
  //   - MCP root key is "mcp"                  (NOT "mcpServers")
  //   - MCP env field is "environment"         (NOT "env")
  //   - An empty value fails later, at the first authenticated call: AGENTS.md
  //     Critical Rule #9 (stop immediately when MCP credentials fail).
  "$schema": "https://opencode.ai/config.json",

  // Plugins:
  //   - `@warp-dot-dev/opencode-warp`: Warp terminal integration — surfaces
  //     OpenCode agent activity as native Warp notifications. Auto-installed
  //     when OpenCode runs inside Warp.
  //     Docs: https://docs.warp.dev/agent-platform/cli-agents/opencode/
  //   - `opencode-subagent-statusline`: renders an active-subagent statusline
  //     in the OpenCode TUI so multi-agent dispatch is visible at a glance.
  "plugin": ["@warp-dot-dev/opencode-warp", "opencode-subagent-statusline"],

  // Local (stdio) servers only. Web search runs at harness level (your user
  // config), never here: see .agents/skills/agentic-dev-core/references/mcp-capabilities.md.
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bunx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
    },
    "supabase": {
      "type": "local",
      "command": [
        "bunx",
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "SUPABASE_ACCESS_TOKEN",
        "--",
        "bunx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
      ],
      "enabled": true,
    },
    "n8n": {
      "type": "local",
      "command": [
        "bunx",
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "N8N_API_URL,N8N_API_KEY",
        "--",
        "npx",
        "-y",
        "n8n-mcp",
      ],
      "enabled": true,
      "environment": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
      },
    },
    // Bunkai project-only: Tavily web search ([WEB_SEARCH_TOOL] primary here), stdio
    // server reading TAVILY_API_KEY from the .env loader.
    "tavily": {
      "type": "local",
      "command": [
        "bunx",
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "TAVILY_API_KEY",
        "--",
        "bunx",
        "-y",
        "tavily-mcp@latest",
      ],
      "enabled": true,
    },
    // Bunkai project-only: browser automation through the Playwright MCP (`--extension`
    // attaches to the running browser). No .env dependency.
    "playwright": {
      "type": "local",
      "command": ["bunx", "@playwright/mcp@latest", "--extension"],
      "enabled": true,
    },
    // Bunkai project-only: DBHub reads dbhub.toml (committed, ${VAR} placeholders only)
    // and expands the DBHUB_* variables the loader hands it. Read-only SQL through the
    // QA inspector role.
    "dbhub": {
      "type": "local",
      "command": [
        "bunx",
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "DBHUB_TYPE,DBHUB_HOST,DBHUB_PORT,DBHUB_DATABASE,DBHUB_USER,DBHUB_PASSWORD",
        "--",
        "bunx",
        "-y",
        "@bytebase/dbhub@1.2.3",
        "--config",
        "dbhub.toml",
      ],
      "enabled": true,
    },
  },

  // Permissions — mirrors .claude/settings.json 1:1.
  // Rule precedence: last matching pattern wins, so deny entries are placed
  // AFTER the broad allows they override (e.g. `git *` allow, then
  // `git push --force *` deny — the deny wins for force-pushes).
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",

      "bun *": "allow",
      "bunx *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "node *": "allow",

      "git *": "allow",
      "gh *": "allow",

      "ls *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "tree *": "allow",
      "test *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "curl *": "allow",

      "acli *": "allow",
      "resend *": "allow",
      "supabase *": "allow",

      "rm -rf *": "deny",
      "sudo rm *": "deny",
      "sudo *": "deny",
      "wget *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd *": "deny",
      "git branch -D *": "deny",
      "chmod 777 *": "deny",
      "truncate *": "deny",
      "shred *": "deny",
      "dd if=*": "deny",
      "mkfs*": "deny",

      // Secrets by NAME, never by value (Critical Rule #1). Same set as the
      // Read/Bash denies in .claude/settings.json.
      "cat *.env": "deny",
      "cat *.env.local": "deny",
      "cat *.env.*.local": "deny",
      "cat *.auth/*": "deny",
      "cat *settings.local.json": "deny",
      "printenv*": "deny",
      "env": "deny",
      "varlock printenv*": "deny",
      "varlock reveal*": "deny",
      "bunx varlock printenv*": "deny",
      "bunx varlock reveal*": "deny",
    },
    // OpenCode's own base policy already asks on `*.env` / `*.env.*` and
    // allows `*.env.example`; these turn the secret-holding paths into a deny.
    // The committed `.env*.schema` files stay readable without a prompt: they
    // hold names, types and `op://` references only (Critical Rule #1).
    "read": {
      "*.env": "deny",
      "*.env.local": "deny",
      "*.env.*.local": "deny",
      "*.envrc.local": "deny",
      "*.auth/*": "deny",
      "*settings.local.json": "deny",
      "*.env.schema": "allow",
      "*.env.*.schema": "allow",
    },
  },
}
